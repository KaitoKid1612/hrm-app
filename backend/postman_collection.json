              "path": ["saved-jobs", "check", "{{jobId}}"]
            }
          }
        },
        {
          "name": "Saved Job IDs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/saved-jobs/ids",
              "host": ["{{baseUrl}}"],
              "path": ["saved-jobs", "ids"]
            }
          }
        }
      ]
    },
    {
      "name": "Job Invites (EMPLOYER/ADMIN)",
      "item": [
        {
