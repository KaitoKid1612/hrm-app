              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/invites/bulk",
              "host": ["{{baseUrl}}"],
              "path": ["invites", "bulk"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jobId\": \"job_123\",\n  \"candidates\": [\n    {\n      \"email\": \"candidate1@example.com\",\n      \"name\": \"Nguyen Van A\",\n      \"phone\": \"0901234567\",\n      \"note\": \"Kinh nghiệm 3 năm\"\n    },\n    {\n      \"email\": \"candidate2@example.com\",\n      \"name\": \"Tran Thi B\",\n      \"phone\": \"0909876543\"\n    }\n  ],\n  \"customMessage\": \"Chúng tôi rất quan tâm đến hồ sơ của bạn\"\n}"
            }
          }
        },
        {
          "name": "Upload CSV & Invite",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/invites/upload-csv/{{jobId}}",
              "host": ["{{baseUrl}}"],
              "path": ["invites", "upload-csv", "{{jobId}}"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "/path/to/candidates.csv",
                  "description": "CSV file with columns: email, name, phone (optional), note (optional)"
                }
              ]
            }
          }
        },
