// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============= ENUMS =============
enum Role {
  ADMIN
  EMPLOYER
  CANDIDATE
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum JobLevel {
  INTERN
  FRESHER
  JUNIOR
  MIDDLE
  SENIOR
  LEADER
  MANAGER
  ENTRY_LEVEL // Cấp độ nhập môn - phù hợp với mọi ngành
  EXPERIENCED // Có kinh nghiệm - phù hợp với mọi ngành
  NOT_REQUIRED // Không yêu cầu cấp bậc - cho các công việc đơn giản
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  SHORTLISTED
  INTERVIEWED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ExperienceLevel {
  NO_EXPERIENCE
  UNDER_1_YEAR
  ONE_TO_THREE_YEARS
  THREE_TO_FIVE_YEARS
  FIVE_TO_TEN_YEARS
  OVER_TEN_YEARS
}

enum CompanyType {
  COMPANY // Công ty
  SMALL_BUSINESS // Hộ kinh doanh/Cá nhân
  HEADHUNTER // Nhà tuyển dụng (headhunter)
}

enum InterviewStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
  NO_SHOW
}

// ============= MODELS =============

model User {
  id       String @id @default(cuid())
  email    String @unique
  password String
  name     String
  role     Role   @default(CANDIDATE)

  // Basic Info
  avatar      String?
  phone       String?
  gender      Gender?
  dateOfBirth DateTime?

  // Location
  address String?
  city    String?
  country String? @default("Vietnam")

  // Professional Info (for Candidates)
  bio               String? @db.Text
  currentJobTitle   String?
  yearsOfExperience Int?    @default(0)
  expectedSalary    Int?
  linkedinUrl       String?
  portfolioUrl      String?
  githubUrl         String?

  // Additional Professional Info
  headline          String? // Short tagline/headline
  availability      String? @default("ACTIVE_LOOKING") // ACTIVE_LOOKING, OPEN, NOT_LOOKING
  noticePeriod      Int?    @default(30) // Days notice period
  willingToRelocate Boolean @default(false)
  languages         String? // JSON: [{name: "English", level: "fluent"}]

  // Social & Professional Links
  twitterUrl  String?
  facebookUrl String?
  websiteUrl  String?

  // Settings & Preferences
  preferredLanguage    String? @default("vi")
  timezone             String? @default("Asia/Ho_Chi_Minh")
  emailNotifications   Boolean @default(true)
  jobAlerts            Boolean @default(true)
  applicationUpdates   Boolean @default(true)
  messageNotifications Boolean @default(true)

  // Email Verification
  emailVerified     Boolean   @default(false)
  emailVerifiedAt   DateTime?
  verificationToken String?

  // Security
  passwordResetToken   String?
  passwordResetExpires DateTime?
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?
  refreshToken         String?   @db.Text
  refreshTokenExpires  DateTime?

  // Account Status
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  bannedAt    DateTime?
  banReason   String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  company             Company?
  resume              Resume?
  applications        Application[]
  savedJobs           SavedJob[]
  conversationsAsUser Conversation[]    @relation("UserConversations")
  messages            Message[]
  notifications       Notification[]
  reviews             Review[]
  workExperiences     WorkExperience[]
  educations          Education[]
  certificates        Certificate[]
  followedCompanies   CompanyFollower[]
  jobAlertSettings    JobAlert[]

  @@map("users")
}

model Company {
  id          String      @id @default(cuid())
  userId      String      @unique
  name        String
  type        CompanyType @default(COMPANY)
  logo        String?
  coverImage  String?
  description String?     @db.Text
  website     String?
  email       String?
  phone       String?
  address     String?
  city        String?
  country     String?     @default("Vietnam")
  size        String? // 1-50, 51-200, 201-500, 500+
  taxCode     String?
  isVerified  Boolean     @default(false)

  // Additional fields
  industry       String? // Ngành nghề: IT, Finance, Marketing, etc.
  foundedYear    Int? // Năm thành lập
  employeeCount  Int? // Số lượng nhân viên thực tế
  benefits       String? @db.Text // Tổng quan phúc lợi công ty
  workingDays    String? @default("Mon-Fri") // Ngày làm việc
  overtimePolicy String? @db.Text // Chính sách làm thêm giờ

  // Social Links
  linkedinUrl String?
  facebookUrl String?
  twitterUrl  String?
  youtubeUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs      Job[]
  reviews   Review[]
  followers CompanyFollower[]

  @@index([industry])
  @@map("companies")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  jobs    Job[]
  resumes Resume[]

  @@map("categories")
}

model Skill {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  jobs    JobSkill[]
  resumes ResumeSkill[]

  @@map("skills")
}

model Job {
  id              String           @id @default(cuid())
  companyId       String?
  categoryId      String
  title           String
  slug            String           @unique
  description     String           @db.Text
  requirements    String           @db.Text
  benefits        String?          @db.Text
  jobType         JobType          @default(FULL_TIME)
  jobLevel        JobLevel         @default(JUNIOR)
  salaryMin       Int?
  salaryMax       Int?
  salaryNegotiate Boolean          @default(false)
  positions       Int              @default(1)
  experience      ExperienceLevel?
  address         String?
  city            String?
  country         String?          @default("Vietnam")
  deadline        DateTime?
  isActive        Boolean          @default(true)
  viewCount       Int              @default(0)

  // Additional important fields
  isRemote        Boolean @default(false)
  isHot           Boolean @default(false) // Việc làm hot - nổi bật đặc biệt
  isUrgent        Boolean @default(false) // Tuyển gấp
  isFeatured      Boolean @default(false) // Việc làm nổi bật
  contactEmail    String?
  contactPhone    String?
  workSchedule    String? // Lịch làm việc: 8h-17h, flexible, etc.
  probationPeriod Int?    @default(60) // Thời gian thử việc (days)
  contractType    String? // Loại hợp đồng: chính thức, thử việc, etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category     Category      @relation(fields: [categoryId], references: [id])
  skills       JobSkill[]
  applications Application[]
  savedJobs    SavedJob[]
  invites      JobInvite[]
  jobBenefits  JobBenefit[]

  @@index([companyId])
  @@index([categoryId])
  @@index([isActive])
  @@index([deadline])
  @@index([isRemote])
  @@index([isHot])
  @@index([isUrgent])
  @@index([isFeatured])
  @@map("jobs")
}

model JobSkill {
  id        String   @id @default(cuid())
  jobId     String
  skillId   String
  createdAt DateTime @default(now())

  // Relations
  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
  @@map("job_skills")
}

model Resume {
  id             String          @id @default(cuid())
  userId         String          @unique
  categoryId     String?
  title          String
  objective      String?         @db.Text
  experience     ExperienceLevel @default(NO_EXPERIENCE)
  education      String?         @db.Text
  workHistory    String?         @db.Text
  certifications String?         @db.Text
  projects       String?         @db.Text
  address        String?
  city           String?
  country        String?         @default("Vietnam")
  gender         Gender?
  dateOfBirth    DateTime?
  isPublic       Boolean         @default(false)
  cvFileUrl      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id])
  skills       ResumeSkill[]
  applications Application[]

  @@index([userId])
  @@index([isPublic])
  @@map("resumes")
}

model ResumeSkill {
  id        String   @id @default(cuid())
  resumeId  String
  skillId   String
  level     String? // beginner, intermediate, advanced, expert
  createdAt DateTime @default(now())

  // Relations
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([resumeId, skillId])
  @@map("resume_skills")
}

model Application {
  id          String            @id @default(cuid())
  jobId       String
  userId      String
  resumeId    String?
  coverLetter String?           @db.Text
  status      ApplicationStatus @default(PENDING)
  appliedAt   DateTime          @default(now())
  reviewedAt  DateTime?
  note        String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relations
  job           Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume        Resume?           @relation(fields: [resumeId], references: [id])
  notifications Notification[]
  interviews    Interview[]
  notes         ApplicationNote[]

  @@unique([jobId, userId])
  @@index([jobId])
  @@index([userId])
  @@index([status])
  @@map("applications")
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@map("saved_jobs")
}

model Conversation {
  id            String    @id @default(cuid())
  userId        String
  companyId     String?
  jobId         String?
  isGroup       Boolean   @default(false)
  name          String?
  lastMessage   String?
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  user         User                      @relation("UserConversations", fields: [userId], references: [id], onDelete: Cascade)
  messages     Message[]
  participants ConversationParticipant[]

  @@index([userId])
  @@map("conversations")
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String   @db.Text
  attachments    String[] // Array of file URLs
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String // application_status, new_job, message, etc.
  data      Json? // Additional data
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   Application? @relation(fields: [applicationId], references: [id])
  applicationId String?

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model Review {
  id           String   @id @default(cuid())
  userId       String
  companyId    String
  rating       Int // 1-5 stars
  title        String
  content      String   @db.Text
  pros         String?  @db.Text
  cons         String?  @db.Text
  isAnonymous  Boolean  @default(false)
  isVerified   Boolean  @default(false) // Admin verified review
  isApproved   Boolean  @default(true) // Auto-approve, admin can reject
  helpfulCount Int      @default(0) // How many found this helpful
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId]) // One review per user per company
  @@index([companyId])
  @@index([userId])
  @@index([rating])
  @@map("reviews")
}

model JobInvite {
  id     String   @id @default(cuid())
  jobId  String
  email  String
  name   String
  phone  String?
  note   String?  @db.Text
  sentBy String // userId who sent the invite
  sentAt DateTime @default(now())

  // Relations
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([email])
  @@map("job_invites")
}

model Interview {
  id            String          @id @default(cuid())
  applicationId String
  scheduledAt   DateTime
  duration      Int             @default(60) // minutes
  location      String? // Physical location or empty for online
  meetingLink   String? // Video call link
  interviewers  String? // JSON array of interviewer names/emails
  notes         String?         @db.Text
  status        InterviewStatus @default(SCHEDULED)
  feedback      String?         @db.Text
  createdBy     String // userId who created the interview
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relations
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([scheduledAt])
  @@index([status])
  @@map("interviews")
}

// ============= NEW MODELS FOR PROFESSIONAL PROFILE =============

model WorkExperience {
  id          String    @id @default(cuid())
  userId      String
  company     String // Tên công ty
  position    String // Vị trí công việc
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  location    String? // Địa điểm làm việc
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("work_experiences")
}

model Education {
  id           String    @id @default(cuid())
  userId       String
  school       String // Tên trường
  degree       String // Bằng cấp: Cử nhân, Thạc sĩ, etc.
  fieldOfStudy String // Chuyên ngành
  startDate    DateTime
  endDate      DateTime?
  isCurrent    Boolean   @default(false)
  grade        String? // GPA hoặc xếp loại
  activities   String?   @db.Text // Hoạt động ngoại khóa
  description  String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("educations")
}

model Certificate {
  id             String    @id @default(cuid())
  userId         String
  name           String // Tên chứng chỉ
  issuingOrg     String // Tổ chức cấp
  issueDate      DateTime
  expirationDate DateTime?
  credentialId   String? // Mã chứng chỉ
  credentialUrl  String? // Link xác minh
  description    String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("certificates")
}

// ============= BENEFITS SYSTEM =============

model Benefit {
  id          String   @id @default(cuid())
  name        String   @unique // Bảo hiểm, Thưởng, Training, etc.
  slug        String   @unique
  icon        String?
  description String?  @db.Text
  category    String? // INSURANCE, BONUS, TRAINING, HEALTH, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  jobBenefits JobBenefit[]

  @@map("benefits")
}

model JobBenefit {
  id        String   @id @default(cuid())
  jobId     String
  benefitId String
  details   String?  @db.Text // Chi tiết cụ thể của benefit cho job này
  createdAt DateTime @default(now())

  // Relations
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  benefit Benefit @relation(fields: [benefitId], references: [id], onDelete: Cascade)

  @@unique([jobId, benefitId])
  @@index([jobId])
  @@index([benefitId])
  @@map("job_benefits")
}

// ============= COMPANY FOLLOWERS =============

model CompanyFollower {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  createdAt DateTime @default(now())

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
  @@map("company_followers")
}

// ============= JOB ALERTS =============

model JobAlert {
  id         String    @id @default(cuid())
  userId     String
  name       String // Tên alert: "Full-stack jobs in HCM"
  keywords   String? // Từ khóa tìm kiếm
  categoryId String?
  city       String?
  jobType    JobType?
  salaryMin  Int?
  isRemote   Boolean?
  isActive   Boolean   @default(true)
  frequency  String    @default("DAILY") // DAILY, WEEKLY, INSTANT
  lastSentAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@map("job_alerts")
}

// ============= APPLICATION NOTES =============

model ApplicationNote {
  id            String   @id @default(cuid())
  applicationId String
  createdBy     String // userId who created note
  content       String   @db.Text
  isPrivate     Boolean  @default(true) // Only visible to company
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([createdBy])
  @@map("application_notes")
}
