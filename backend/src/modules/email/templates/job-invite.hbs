<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <style>
      body {
        font-family: Arial, sans-serif;
        line-height: 1.6;
        color: #333;
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
      }
      .header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 30px;
        border-radius: 10px 10px 0 0;
        text-align: center;
      }
      .content {
        background: #f9f9f9;
        padding: 30px;
        border-radius: 0 0 10px 10px;
      }
      .job-info {
        background: white;
        padding: 20px;
        border-left: 4px solid #667eea;
        margin: 20px 0;
      }
      .button {
        display: inline-block;
        padding: 12px 30px;
        background: #667eea;
        color: white;
        text-decoration: none;
        border-radius: 5px;
        margin: 20px 0;
      }
      .custom-message {
        background: #e3f2fd;
        border-left: 4px solid #2196F3;
        padding: 15px;
        margin: 20px 0;
        font-style: italic;
      }
      .footer {
        text-align: center;
        margin-top: 30px;
        color: #666;
        font-size: 14px;
      }
    </style>
  </head>
  <body>
    <div class="header">
      <h1>🎯 Cơ Hội Việc Làm Dành Cho Bạn!</h1>
    </div>
    <div class="content">
      <p>Xin chào <strong>{{candidateName}}</strong>,</p>
      
      <p>Chúng tôi từ <strong>{{companyName}}</strong> rất vui được giới thiệu đến bạn một cơ hội việc làm phù hợp với hồ sơ của bạn.</p>
      
      <div class="job-info">
        <h3 style="margin-top: 0; color: #667eea;">📋 Thông tin vị trí tuyển dụng</h3>
        <p><strong>Vị trí:</strong> {{jobTitle}}</p>
        <p><strong>Công ty:</strong> {{companyName}}</p>
      </div>

      {{#if customMessage}}
      <div class="custom-message">
        <p><strong>💬 Lời nhắn từ HR:</strong></p>
        <p>{{customMessage}}</p>
      </div>
      {{/if}}
      
      <p>Chúng tôi tin rằng kinh nghiệm và kỹ năng của bạn sẽ rất phù hợp với vị trí này. Hãy xem chi tiết công việc và nộp đơn ứng tuyển ngay hôm nay!</p>
      
      <div style="text-align: center;">
        <a href="{{jobUrl}}" class="button">Xem Chi Tiết & Ứng Tuyển Ngay</a>
      </div>
      
      <p style="margin-top: 30px;">Nếu bạn có bất kỳ câu hỏi nào, đừng ngần ngại liên hệ với chúng tôi qua email: 
        {{#if hrEmail}}
          <a href="mailto:{{hrEmail}}">{{hrEmail}}</a>
        {{else}}
          <a href="mailto:{{supportEmail}}">{{supportEmail}}</a>
        {{/if}}
      </p>
      
      <p>Chúc bạn thành công!</p>
      <p><strong>Đội ngũ tuyển dụng {{companyName}}</strong></p>
    </div>
    <div class="footer">
      <p>Email này được gửi từ hệ thống tuyển dụng {{appName}}</p>
      <p>© 2025 {{appName}}. All rights reserved.</p>
    </div>
  </body>
</html>
