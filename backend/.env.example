# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/hrm_dev?schema=public"

# JWT
JWT_SECRET="your_secret_key"
JWT_EXPIRES_IN="7d"

# Mail / SMS (optional)
SMTP_USER=""
SMTP_PASS=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# Redis (for BullMQ)
REDIS_URL=redis://localhost:6379
