# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/hrm_dev?schema=public"

# JWT
JWT_SECRET="your_secret_key"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your_refresh_secret_key"
JWT_REFRESH_EXPIRES_IN="30d"

# App Info
APP_NAME="Vũng Áng Jobs"
SUPPORT_EMAIL="support@vungangjobs.vn"
MAIL_FROM="noreply@vungangjobs.vn"

# Mail / SMTP (optional - for email features)
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=""
MAIL_PASSWORD=""

# Cloudinary (for cloud storage - optional, defaults to local storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Redis (for BullMQ - optional)
REDIS_URL=redis://localhost:6379
